# Foreman configuration — copy to .env and fill in.
# Foreman degrades gracefully: only ANTHROPIC_API_KEY is strictly required.

# --- Required: the model credentials the harness + engine use ---
# Used both to drive the Claude Agent SDK (execution) and to call the Claude
# API for the direction proposal and the LLM grader.
ANTHROPIC_API_KEY=

# --- Optional: models (sane defaults baked in) ---
# Direction proposals + LLM grading. Defaults to claude-opus-4-8.
FOREMAN_MODEL=claude-opus-4-8
# The model the Agent SDK executes with. Defaults to claude-opus-4-8.
FOREMAN_EXECUTOR_MODEL=claude-opus-4-8

# --- Optional: defaults for a run (all overridable per-invocation) ---
# Hard budget ceiling in USD. The run winds down cleanly at this number.
FOREMAN_BUDGET_USD=0.60
# Involvement dial: light | normal | hands-on. Default normal.
FOREMAN_DIAL=normal

# --- Optional: engine selection + signing ---
# Which trust engine backs the harness: "local" (default, self-contained) or
# "ledgermind" (delegate grading/proof to a running Ledgermind instance).
FOREMAN_ENGINE=local
# EIP-712 oracle key for signing work proofs (0x-prefixed private key). If
# unset, LocalEngine issues an unsigned, hash-only proof (still verifiable by
# content, just not attested). Mirrors Ledgermind's optional-on-chain pattern.
FOREMAN_ORACLE_KEY=

# --- Optional: Ledgermind-backed engine (FOREMAN_ENGINE=ledgermind) ---
# Base URL of a running Ledgermind instance whose POST /api/grade judges work.
LEDGERMIND_URL=https://ai-agent-credit-dashboard.vercel.app
# Bearer token for /api/grade. Grading bills YOUR Ledgermind account's LLM key
# (BYOK chain) and a pass mints a publicly verifiable proof at /proof/<id>.
# Mint one:
#   curl -X POST $LEDGERMIND_URL/api/oauth/personal-token \
#     -H 'Content-Type: application/json' -d '{"email":"you@…","password":"…"}'
# Without a token the engine runs fully local — no anonymous calls are made.
LEDGERMIND_TOKEN=
